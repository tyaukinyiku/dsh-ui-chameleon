{
  "name": "dsh-ui-pack-terminal",
  "version": "0.1.0",
  "type": "module",
  "description": "Terminal UI pack：CRT 磷光绿屏（扫描线、荧光字、等宽零圆角）",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client.ts",
      "default": "./lib/client.js"
    }
  },
  "files": ["src", "lib/client.js", "cordis.patch.yml"],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build:client": "node ../../scripts/build-client.mjs ."
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
